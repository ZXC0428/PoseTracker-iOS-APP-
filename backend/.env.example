# SQL Server 使用 SQL 帳號登入的範例。正式環境請使用有效 TLS 憑證，
# 並把 TrustServerCertificate 改為 no。
SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=PoseTracker;UID=pose_api;PWD=CHANGE_ME;Encrypt=yes;TrustServerCertificate=yes

# 使用 `python -c "import secrets; print(secrets.token_hex(32))"` 產生。
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_HEX_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60

